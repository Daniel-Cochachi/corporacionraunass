---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import WhatsAppButton from '../../components/WhatsAppButton.astro';
import Icon from '../../components/Icon.astro';
import CTA from '../../components/CTA.astro';

const items = [
    "Estructuras de acero para Cines.",
    "Estructuras de acero para Almacenes.",
    "Estructuras de acero para Centros Comerciales y Supermercados."
];
---

<BaseLayout title="Edificaciones - Corporación Raunass">
    <Navbar />
    <main>
        <section class="service-detail">
            <div class="container">
                <div class="detail-header">
                    <span class="category">Servicios</span>
                    <h1>Edificaciones</h1>
                    <p class="lead">Ingeniería estructural avanzada para centros comerciales, cines y almacenes industriales de gran luz.</p>
                </div>

                <div class="content-grid">
                    <div class="image-box">
                        <img src="/servicio-edificaciones.webp" alt="Servicios de Edificaciones" />
                    </div>
                    <div class="info-box">
                        <p>Desarrollamos estructuras de acero diseñadas para maximizar el espacio y garantizar la seguridad estructural en edificaciones de gran envergadura. Nuestro equipo de ingeniería utiliza software de última generación para modelar y fabricar estructuras precisas que agilizan los tiempos de montaje en obra.</p>
                        
                        <ul class="detail-list">
                            {items.map(item => (
                                <li>
                                    <Icon name="check" size={20} color="var(--accent)" />
                                    <span>{item}</span>
                                </li>
                            ))}
                        </ul>
                    </div>
                </div>
            </div>
        </section>
        <CTA />
    </main>
    <Footer />
    <WhatsAppButton />
</BaseLayout>

<style>
    .service-detail {
        padding: 5rem 0;
    }

    .detail-header {
        margin-bottom: 4rem;
        max-width: 800px;
    }

    .category {
        color: var(--accent);
        font-weight: 700;
        text-transform: uppercase;
        font-size: 0.9rem;
        letter-spacing: 1px;
        display: block;
        margin-bottom: 1rem;
    }

    .detail-header h1 {
        font-size: 3.5rem;
        margin-bottom: 1.5rem;
    }

    .lead {
        font-size: 1.25rem;
        color: var(--text-light);
    }

    .content-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 4rem;
        align-items: start;
    }

    .image-box img {
        width: 100%;
        border-radius: var(--radius);
        box-shadow: var(--shadow);
    }

    .info-box p {
        font-size: 1.1rem;
        line-height: 1.8;
        margin-bottom: 2.5rem;
    }

    .detail-list {
        display: flex;
        flex-direction: column;
        gap: 1rem;
    }

    .detail-list li {
        display: flex;
        align-items: center;
        gap: 1rem;
        padding: 1rem;
        background: var(--bg-alt);
        border-radius: 8px;
        transition: var(--transition);
    }

    .detail-list li:hover {
        transform: translateX(10px);
        background: var(--white);
        box-shadow: var(--shadow-sm);
    }

    @media (max-width: 992px) {
        .content-grid {
            grid-template-columns: 1fr;
            gap: 2rem;
        }

        .detail-header h1 {
            font-size: 2.5rem;
        }
    }
</style>
